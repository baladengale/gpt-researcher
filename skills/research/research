PY
  [ $? -eq 0 ] || die "failed to update multi_agents/task.json"

  err "research: running multi_agents/main.py — expect 5-20 min (plan -> parallel research -> review -> publish)"
  _run() { ( cd "$GPTR_HOME" || exit 1; exec "$REPO/.venv/bin/python" -u multi_agents/main.py ); }
  run_streamed "$RUN_LOG" _run
  local rc=$RUN_RC

  local out=""
  if [ $rc -eq 0 ]; then
    out=$(sed -n 's/^Report written to \(.*\.md\)$/\1/p' "$RUN_LOG" | tail -1)
    [ -n "$out" ] || out=$(newest_after "$GPTR_HOME/outputs" "run_*/*.md" "$marker")
  fi
  rm -f "$marker"
  [ $rc -eq 0 ] || { err "research: multi run failed (rc=$rc); log tail:"; tail -20 "$RUN_LOG" >&2; exit $rc; }
  [ -n "$out" ] || die "no output md found (log: $RUN_LOG)"
  out=$(resolve_path "$out")
  preview_report "$out"
  local run_dir; run_dir=$(dirname "$out")
  printf '{"path":"%s","run_dir":"%s","title":null,"sources_count":null,"total_cost_usd":null}\n' \
    "$(json_escape "$out")" "$(json_escape "$run_dir")"
}

# scan_reports <mode> [selector] — stdlib-python scanner shared by list /
# resolve / view. Modes: list (human table -> stderr, ONE JSON array line ->
# stdout, newest first), resolve <sel> (ONE JSON line for the selector),
# path <sel> (bare resolved path, for cmd_view). Selector: list index, file
# path, directory (newest .md inside), or case-insensitive title/filename
# substring (must match exactly one).
scan_reports() {
  local mode="$1" sel="${2:-}"
  GPTR_MODE="$mode" GPTR_SEL="$sel" "$REPO/.venv/bin/python" - <<'PY'
import datetime, glob, json, os, re, sys

REPO = "/Users/bala/workspace/gpt-researcher"
MODE = os.environ.get("GPTR_MODE", "list")
SEL = os.environ.get("GPTR_SEL", "")

def die(msg, code=2):
    print(f"research: {msg}", file=sys.stderr)
    sys.exit(code)

def frontmatter(text):
    """Key/value dict from the YAML frontmatter block; {} when absent."""
    meta = {}
    if not text.startswith("---"):
        return meta
    for line in text.splitlines()[1:]:
        if line.strip() == "---":
            break
        if ":" in line:
            k, v = line.split(":", 1)
            meta[k.strip()] = v.strip().strip('"').strip("'")
    return meta

def scan():
    """All reports under the three on-disk locations, newest first."""
    pats = (
        (os.path.join(REPO, "outputs", "*.md"), "cli"),
        (os.path.join(REPO, "outputs", "run_*", "*.md"), "multi"),
        (os.path.join(REPO, "deep_agents", "outputs", "run_*", "report.md"), "deep"),
    )
    entries, seen = [], set()
    for pat, kind in pats:
        for f in sorted(glob.glob(pat)):
            if f in seen or not os.path.isfile(f):
                continue
            seen.add(f)
            try:
                with open(f, encoding="utf-8", errors="replace") as fh:
                    meta = frontmatter(fh.read(8192))
            except OSError:
                continue
            st = os.stat(f)
            title = meta.get("title") or (
                re.sub(r"^run_\d+_", "", os.path.basename(os.path.dirname(f)))
                if kind == "multi" else os.path.splitext(os.path.basename(f))[0]
            )
            entries.append({
                "path": f, "kind": kind, "title": title,
                "date": datetime.datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M"),
                "mtime": st.st_mtime, "size_bytes": st.st_size,
                "sources_count": meta.get("sources_count") or None,
                "total_cost_usd": meta.get("total_cost_usd") or None,
            })
    entries.sort(key=lambda e: -e.pop("mtime"))
    return entries

def table(entries, out=sys.stderr):
    if not entries:
        print("no reports yet — run: research \"<query>\"", file=out)
        return
    print(f"{'#':>2}  {'date':16}  {'kind':5}  {'src':>3}  {'cost':>8}  title", file=out)
    for i, e in enumerate(entries, 1):
        t = e["title"] if len(e["title"]) <= 58 else e["title"][:57] + "..."
        print(f"{i:>2}  {e['date']:16}  {e['kind']:5}  {str(e['sources_count'] or '-'):>3}"
              f"  {str(e['total_cost_usd'] or '-'):>8}  {t}", file=out)

def resolve(entries):
    """(path, entry|None) for SEL; dies with guidance when unresolvable."""
    if not entries:
        die('no reports yet — run: research "<query>"')
    if not SEL:
        return entries[0]["path"], entries[0]          # newest
    if re.fullmatch(r"\d+", SEL):
        n = int(SEL)
        if not 1 <= n <= len(entries):
            die(f"index {n} out of range 1..{len(entries)} — run: research list")
        return entries[n - 1]["path"], entries[n - 1]
    p = SEL if os.path.isabs(SEL) else os.path.join(REPO, SEL)
    if os.path.isdir(p):
        mds = sorted(glob.glob(os.path.join(p, "**", "*.md"), recursive=True),
                     key=os.path.getmtime, reverse=True)
        if not mds:
            die(f"no .md under directory: {p}")
        return mds[0], None
    if os.path.isfile(p):
        return p, None
    hay = SEL.lower()
    idxs = [(i, e) for i, e in enumerate(entries, 1)
            if hay in e["title"].lower() or hay in os.path.basename(e["path"]).lower()]
    if len(idxs) == 1:
        i, e = idxs[0]
        return e["path"], e
    if not idxs:
        die(f"no report matching '{SEL}' — run: research list")
    die(f"'{SEL}' is ambiguous ({len(idxs)} matches): "
        + "; ".join(f"#{i} {e['title'][:34]}" for i, e in idxs))

if MODE == "list":
    es = scan()
    table(es)
    print(json.dumps(es))
elif MODE == "resolve":
    path, e = resolve(scan())
    if e is None:
        print(json.dumps({"path": path}))
    else:
        print(json.dumps({"path": path, "title": e["title"], "kind": e["kind"],
                          "sources_count": e["sources_count"],
                          "total_cost_usd": e["total_cost_usd"]}))
elif MODE == "path":
    path, _ = resolve(scan())
    print(path)
else:
    die(f"scan_reports: unknown mode {MODE}")
PY
}

# cmd_list — human table on stderr, ONE JSON array line on stdout. Read-only.
cmd_list() {
  require_repo
  scan_reports list
}

# cmd_resolve <selector> — print the resolved report path as one JSON line,
# without opening anything. Lets a consumer map "view #2" / "view avgo" to a
# path first. Read-only.
cmd_resolve() {
  [ -n "${1:-}" ] || die "resolve: pass an index, path, directory, or title substring"
  require_repo
  scan_reports resolve "$1"
}

# cmd_view [selector] [--term] — resolve the selector (default: newest), then
# glow-render the report to the terminal (--term, human mode, no JSON) or
# render it to styled HTML with the repo venv's markdown lib and open it in
# the default browser. Read-only: no API calls, no lock, no .env needed.
cmd_view() {
  local sel="" term=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --term) term=1; shift ;;
      *) [ -z "$sel" ] || die "view: unexpected extra argument: $1"
         sel="$1"; shift ;;
    esac
  done
  require_repo
  local f
  f=$(scan_reports path "$sel") || exit 1
  [ -f "$f" ] || die "report not found: $f"
  if [ "$term" = 1 ]; then
    [ -n "$GPTR_GLOW" ] || die "glow not found (brew install glow)"
    local end; end=$(awk 'NR>1 && /^---[[:space:]]*$/{print NR; exit}' "$f")
    err "research: ---- $f (glow) ----"
    if [ -n "$end" ]; then
      tail -n +"$((end + 1))" "$f" | "$GPTR_GLOW" -
    else
      "$GPTR_GLOW" "$f"
    fi
    return 0
  fi
  local out_html="${TMPDIR:-/tmp}/research-view-$(basename "${f%.md}").html"
  GPTR_MD="$f" GPTR_HTML="$out_html" "$REPO/.venv/bin/python" - <<'PY'
import datetime, os, markdown
src, dst = os.environ["GPTR_MD"], os.environ["GPTR_HTML"]
with open(src, encoding="utf-8") as fh:
    text = fh.read()
title = os.path.basename(src)[:-3]
meta = {}
if text.startswith("---"):
    lines = text.splitlines()
    for i, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            for h in lines[1:i]:
                if ":" in h:
                    k, v = h.split(":", 1)
                    meta[k.strip()] = v.strip().strip('"')
            for h in lines[1:i]:
                if h.startswith("title:"):
                    title = h.split(":", 1)[1].strip().strip('"')
                    break
            text = "\n".join(lines[i + 1:])
            break
body = markdown.markdown(text, extensions=["fenced_code", "tables", "sane_lists"])
CSS = """
body{font-family:-apple-system,system-ui,'Segoe UI',sans-serif;max-width:860px;margin:40px auto;padding:0 24px;line-height:1.65;color:#1a1a2e;background:#fdfdfd}
h1{border-bottom:2px solid #e8e8ee;padding-bottom:8px}
h2{border-bottom:1px solid #eee;padding-bottom:5px;margin-top:2em}
code{background:#f2f2f6;padding:2px 5px;border-radius:4px;font-size:.9em}
pre{background:#f2f2f6;padding:14px;border-radius:8px;overflow-x:auto}
pre code{background:none;padding:0}
blockquote{border-left:4px solid #d5d5e2;margin:0;padding:2px 16px;color:#555}
table{border-collapse:collapse}
th,td{border:1px solid #ddd;padding:6px 12px}
th{background:#f2f2f6}
a{color:#0a66d0}
img{max-width:100%}
.meta{color:#888;font-size:.85em;margin-bottom:24px}
"""
bits = [datetime.datetime.fromtimestamp(os.path.getmtime(src)).strftime("%Y-%m-%d %H:%M")]
if meta.get("sources_count"):
    bits.append(meta["sources_count"] + " sources")
if meta.get("total_cost_usd"):
    bits.append("$" + meta["total_cost_usd"])
html = ('<!doctype html><html><head><meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width,initial-scale=1">'
        '<title>' + title + '</title><style>' + CSS + '</style></head><body>'
        '<div class="meta">' + " | ".join(bits) + " | " + src + '</div>'
        + body + '</body></html>')
with open(dst, "w", encoding="utf-8") as fh:
    fh.write(html)
print("rendered:", dst)
PY
  [ $? -eq 0 ] || die "failed to render $f to HTML"
  err "research: opening in browser — $out_html"
  open "$out_html"
  printf '{"path":"%s","html":"%s"}\n' "$(json_escape "$f")" "$(json_escape "$out_html")"
}

port_up() { curl -s -o /dev/null --max-time 3 "$API_URL" ; }

cmd_serve() {
  local action="${1:-status}"
  case "$action" in
    start)
      require_repo
      if [ -f "$API_PID" ] && kill -0 "$(cat "$API_PID")" 2>/dev/null; then
        err "research: server already running (pid $(cat "$API_PID"))"
      else
        err "research: starting run_api.sh in background (log: $API_LOG)"
        ( cd "$REPO" && nohup ./run_api.sh >"$API_LOG" 2>&1 & echo $! >"$API_PID" )
        sleep 1
      fi
      local i=0
      while [ $i -lt 60 ]; do
        if port_up; then err "research: server ready on $API_URL"; exit 0; fi
        sleep 2; i=$((i + 1))
      done
      die "server did not become ready in 120s (log: $API_LOG)"
      ;;
    stop)
      if [ -f "$API_PID" ]; then
        local pid; pid=$(cat "$API_PID")
        if kill -0 "$pid" 2>/dev/null; then
          kill "$pid" 2>/dev/null; pkill -P "$pid" 2>/dev/null; sleep 2
          kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
          err "research: server stopped (pid $pid)"
        else
          err "research: stale pidfile, pid $pid not running"
        fi
        rm -f "$API_PID"
      else
        err "research: no pidfile ($API_PID) — server not started by research"
      fi
      ;;
    status)
      if [ -f "$API_PID" ] && kill -0 "$(cat "$API_PID")" 2>/dev/null; then
        if port_up; then err "research: running (pid $(cat "$API_PID")), $API_URL responding"
        else err "research: process alive (pid $(cat "$API_PID")) but $API_URL not responding yet"; fi
      else
        err "research: not running"
      fi
      ;;
    *) die "serve: use start|stop|status" ;;
  esac
}

main() {
  [ $# -ge 1 ] || { usage; exit 1; }
  # Research-first (BALA rename directive 2026-11-07): the first argument is
  # the QUERY unless it is a secondary subcommand.
  case "$1" in
    deep)  shift; cmd_deep "$@" ;;
    multi) shift; cmd_multi "$@" ;;
    list)  shift; cmd_list "$@" ;;
    resolve) shift; cmd_resolve "$@" ;;
    view)  shift; cmd_view "$@" ;;
    serve) shift; cmd_serve "$@" ;;
    help|-h|--help) usage; exit 0 ;;
    *)     cmd_research "$@" ;;
  esac
}

main "$@"
